# Copy to your deployment environment; never commit real credentials.
NODE_ENV=development
PORT=3000
DATA_DIR=./data

# Bootstrap the first administrator on server startup.
ADMIN_USERNAME=your-admin-username
ADMIN_PASSWORD=use-a-long-unique-password
ADMIN_EMAIL=admin@example.com

# Billplz Sandbox. Switch BILLPLZ_MODE=live only after merchant approval.
BILLPLZ_MODE=sandbox
BILLPLZ_API_KEY=
BILLPLZ_COLLECTION_ID=
PUBLIC_BASE_URL=https://your-public-https-domain.example
